# Vercel Storage → Private Blob store (Vercel sets this on connection)
BLOB_READ_WRITE_TOKEN=

# Meta for Developers → WhatsApp → API Setup / Meta Business Settings → System users
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional account identifier for management tasks; sending uses the phone number ID
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Your destination WhatsApp number, international format, digits only
WHATSAPP_RECIPIENT_NUMBER=
# Match an approved template in WhatsApp Manager
WHATSAPP_TEMPLATE_NAME=autocharge_new_order
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_GRAPH_VERSION=v24.0

# Optional secure admin retry endpoint; choose at least 32 random characters
ORDER_RETRY_SECRET=
